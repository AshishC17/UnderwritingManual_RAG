{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Single-question retry evaluation dataset",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","suite","split","review_status","cases"],
  "properties":{
    "schema_version":{"enum":["1.0"]}, "suite":{"enum":["retry_eval_v1"]}, "split":{"enum":["dev","holdout"]},
    "review_status":{"type":"string"}, "cases":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/case"}}
  },
  "definitions":{
    "strings":{"type":"array","items":{"type":"string"}},
    "scope":{"type":["object","null"],"required":["lender_id","document_version"],"additionalProperties":false,"properties":{"lender_id":{"enum":["novacred","lumentrail"]},"document_version":{"enum":["V0","V1"]}}},
    "aspect":{"type":"object","required":["id","need","claim_indices"],"additionalProperties":false,"properties":{"id":{"type":"string"},"need":{"type":"string"},"claim_indices":{"type":"array","minItems":1,"items":{"type":"integer","minimum":0}}}},
    "group":{"type":"object","required":["name","requirement","any_of_source_refs"],"additionalProperties":false,"properties":{"name":{"type":"string"},"requirement":{"type":"string"},"any_of_source_refs":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "case":{
      "type":"object","additionalProperties":false,
      "required":["id","family","difficulty","tags","question","answerability","expected_response","expected_scope","scenario_constraints","ground_truth_answer","required_claims","forbidden_claims","required_aspects","evidence_groups"],
      "properties":{
        "id":{"type":"string"},"family":{"type":"string"},"difficulty":{"enum":["easy","medium","difficult","extreme"]},
        "tags":{"$ref":"#/definitions/strings"},"question":{"type":"string"},
        "answerability":{"enum":["answerable","partially_answerable","unanswerable","needs_clarification"]},
        "expected_response":{"enum":["answer","qualified_answer","clarify"]},"expected_scope":{"$ref":"#/definitions/scope"},
        "scenario_constraints":{"$ref":"#/definitions/strings"},"ground_truth_answer":{"type":"string"},
        "required_claims":{"type":"array","minItems":1,"items":{"type":"string"}},"forbidden_claims":{"$ref":"#/definitions/strings"},
        "required_aspects":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/aspect"}},"evidence_groups":{"type":"array","items":{"$ref":"#/definitions/group"}},"author_notes":{"type":"string"}
      }
    }
  }
}
