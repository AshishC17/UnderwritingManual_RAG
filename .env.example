# Required for the live document assistant. Supply your own credentials.
GROQ_API_KEY=
VOYAGE_API_KEY=

# Local Compose demo database; never use these credentials for public deployment.
STATE_DATABASE_URL=postgresql://rag:rag@127.0.0.1:5432/rag
STATE_DB_POOL_SIZE=10
LOCAL_DEMO_TENANT=local-demo
RAG_CORRECTION_MODE=post_generation

# Optional tracing; enabling it sends sanitized execution traces to LangSmith.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=underwriting-rag

# Set only after bootstrapping your own local index release.
# RAG_INDEX_ALIAS=uw_manual_active
# Optional vision captioning for NEW diagrams; bundled captions need no vision API.
# ANTHROPIC_API_KEY=
